@page "/movies"
@page "/tv"
@page "/games"
@attribute [Authorize]

<PageTitle>@kind.Label() - ReelSoon</PageTitle>

<div class="reel-watch @(drawerOpen ? "is-drawer-open" : null)">
    <PageHeader Title="@kind.Label()" Description="@(!loading && loadError is null ? Summary : null)">
        <Actions>
            <button type="button" class="nf-button nf-button-primary" @onclick="StartCreate">
                <Icon Name="plus" /> Add @kind.Singular().ToLowerInvariant()
            </button>
        </Actions>
    </PageHeader>

    @if (!loading && loadError is null && items.Count > 0)
    {
        <div class="nf-chip-row reel-filters" role="tablist">
            <button type="button" class="nf-chip @(filter == ListFilter.All ? "is-active" : null)" @onclick="() => filter = ListFilter.All">All</button>
            <button type="button" class="nf-chip @(filter == ListFilter.Upcoming ? "is-active" : null)" @onclick="() => filter = ListFilter.Upcoming">Coming up</button>
            <button type="button" class="nf-chip @(filter == ListFilter.Released ? "is-active" : null)" @onclick="() => filter = ListFilter.Released">Released</button>
        </div>
    }

    @if (loading)
    {
        <p class="nf-muted">Loading.</p>
    }
    else if (loadError is not null)
    {
        <EmptyState Icon="alert" Title="This list could not be read" Description="@loadError" />
    }
    else if (items.Count == 0)
    {
        <EmptyState Icon="@kind.Icon()" Title="@EmptyTitle" Description="@EmptyBody">
            @if (string.IsNullOrWhiteSpace(Query))
            {
                <button type="button" class="nf-button nf-button-primary" @onclick="StartCreate">
                    <Icon Name="plus" /> Add @kind.Singular().ToLowerInvariant()
                </button>
            }
            else
            {
                <a class="nf-button" href="@kind.Route()">Clear search</a>
            }
        </EmptyState>
    }
    else if (visible.Count == 0)
    {
        <EmptyState Icon="search" Title="Nothing in this filter">
            <button type="button" class="nf-button" @onclick="() => filter = ListFilter.All">Show all</button>
        </EmptyState>
    }
    else
    {
        <div class="nf-poster-grid" role="list">
            @foreach (var item in visible)
            {
                <button type="button"
                        class="nf-poster-card @(selected?.Id == item.Id && !creating ? "is-selected" : null)"
                        @onclick="() => Open(item)"
                        @key="item.Id">
                    <span class="nf-poster-cover">
                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" alt="" />
                        }
                        else
                        {
                            <Icon Name="@item.Kind.Icon()" Size="28" />
                        }
                        <span class="nf-badge @StatusClass(item)">@ReleaseText.Status(item.ReleaseDate, Today)</span>
                    </span>
                    <span class="nf-poster-title">@item.Title</span>
                    <span class="nf-muted nf-small">@ReleaseText.Relative(item.ReleaseDate, Today)</span>
                </button>
            }
        </div>
    }

    @if (drawerOpen)
    {
        <ItemDrawer Kind="kind"
                    Item="selected"
                    Creating="creating"
                    Editing="editing"
                    Form="form"
                    Today="Today"
                    Saving="saving"
                    Error="@formError"
                    Hits="hits"
                    Searching="searching"
                    Searched="searched"
                    SearchError="@searchError"
                    Manual="manual"
                    CatalogLinked="selected?.CatalogSource is not null"
                    OnSearch="SearchCatalogAsync"
                    OnPreview="PreviewAsync"
                    Preview="preview"
                    OnBack="BackToResults"
                    OnAddPreview="AddPreviewAsync"
                    Trailers="DrawerTrailers"
                    OnShowManual="ShowManual"
                    OnClose="CloseDrawer"
                    OnEdit="BeginEdit"
                    OnCancelEdit="CancelEdit"
                    OnSave="SaveAsync"
                    OnDelete="DeleteAsync" />
    }
</div>
