@inherits LayoutComponentBase

@* ShellLayout cannot do this one: the notification bell and its polling live in the topbar. *@
<AppShell Brand="@shell.Brand"
          BrandHref="@shell.BrandHref"
          LogoUrl="@shell.LogoUrl"
          MarkUrl="@shell.MarkUrl"
          Sections="Sections"
          ShowSearch="true"
          SearchPlaceholder="@shell.SearchPlaceholder"
          OnSearch="Search"
          ShowVersion="@shell.ShowVersion"
          Version="@shell.Version">
    <SidebarFooter>
        <AuthorizeView Roles="@WellKnownRoles.Administrator">
            <ul class="nf-nav" aria-label="Administration">
                @foreach (var item in AdminLinks)
                {
                    <ForgeNavLink Item="item" />
                }
            </ul>
        </AuthorizeView>
    </SidebarFooter>
    <TopbarEnd>
        <button type="button"
                class="nf-icon-button @(notificationsOpen ? "is-active" : null)"
                title="Notifications"
                aria-label="Notifications"
                aria-expanded="@(notificationsOpen ? "true" : "false")"
                @onclick="ToggleNotifications">
            <Icon Name="bell" />
            @if (unreadCount > 0)
            {
                <span class="nf-badge-count">@(unreadCount > 9 ? "9+" : unreadCount.ToString())</span>
            }
        </button>
    </TopbarEnd>
    <ChildContent>
        @Body
    </ChildContent>
</AppShell>

@if (notificationsOpen)
{
    <div class="nf-drawer-scrim" @onclick="CloseNotifications"></div>
    <NotificationDrawer OnClose="CloseNotifications" />
}
