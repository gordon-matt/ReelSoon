<aside class="rs-details" aria-label="@(Creating ? "Add title" : Item?.Title)">
    <header class="rs-details-head">
        <div class="rs-details-title">
            @if (Preview is not null)
            {
                <span class="rs-badge @PreviewStatusClass">@ReleaseText.Status(Preview.ReleaseDate, Today)</span>
                <strong>@Preview.Title</strong>
            }
            else if (Creating)
            {
                <span>New @Kind.Singular().ToLowerInvariant()</span>
            }
            else if (Item is not null)
            {
                <span class="rs-badge @StatusClass">@ReleaseText.Status(Item.ReleaseDate, Today)</span>
                <strong>@Item.Title</strong>
            }
        </div>
        <div class="rs-details-actions">
            @if (Item is not null && !Editing)
            {
                <button type="button" class="rs-icon-button" title="Edit" @onclick="OnEdit">
                    <Icon Name="edit" />
                </button>
                <button type="button" class="rs-icon-button rs-danger-hover" title="Remove" @onclick="OnDelete">
                    <Icon Name="trash" />
                </button>
            }
            <button type="button" class="rs-icon-button" title="Close" @onclick="OnClose">
                <Icon Name="x" />
            </button>
        </div>
    </header>

    <div class="rs-details-body">
        @if (Creating && Preview is not null)
        {
            @if (!string.IsNullOrWhiteSpace(Preview.ImageUrl))
            {
                <img class="rs-details-image" src="@Preview.ImageUrl" alt="" />
            }

            <dl class="rs-facts">
                <dt>Release</dt>
                <dd>
                    @if (Preview.ReleaseDate is DateOnly releaseDate)
                    {
                        <span>@ReleaseText.Long(releaseDate)</span>
                        <span class="rs-muted"> · @ReleaseText.Relative(releaseDate, Today)</span>
                    }
                    else
                    {
                        <span class="rs-muted">No date yet</span>
                    }
                </dd>
                <dt>Type</dt>
                <dd>@Preview.Kind.Singular()</dd>
                <dt>Source</dt>
                <dd>@(Preview.Source == CatalogSource.Igdb ? "IGDB" : "TMDB")</dd>
            </dl>

            @if (!string.IsNullOrWhiteSpace(Preview.Overview))
            {
                <section>
                    <h4>About</h4>
                    <p class="rs-notes">@Preview.Overview</p>
                </section>
            }

            @if (!string.IsNullOrWhiteSpace(SearchError))
            {
                <p class="rs-validation" role="alert">@SearchError</p>
            }

            <div class="rs-form-actions">
                <button type="button" class="rs-button" @onclick="OnBack" disabled="@Saving">Back</button>
                <button type="button" class="rs-button rs-button-primary" @onclick="OnAddPreview" disabled="@Saving">
                    @(Saving ? "Adding…" : Preview.Kind == Kind ? "Add" : $"Add to {Preview.Kind.Label()}")
                </button>
            </div>
        }
        else if (Creating)
        {
            <div class="rs-field">
                <label for="catalog-query">Search</label>
                <input id="catalog-query"
                       class="rs-input"
                       value="@query"
                       @oninput="OnQueryInput"
                       placeholder="@SearchPlaceholder"
                       autocomplete="off"
                       autofocus />
                <span class="rs-hint">@SearchHint</span>
            </div>

            @if (Searching)
            {
                <p class="rs-muted">Searching…</p>
            }
            else if (!string.IsNullOrWhiteSpace(SearchError))
            {
                <p class="rs-validation" role="alert">@SearchError</p>
            }
            else if (query.Trim().Length >= 2 && Hits.Count == 0 && Searched)
            {
                <p class="rs-hint">Nothing matched. You can add it yourself.</p>
            }

            @if (Hits.Count > 0)
            {
                <div class="rs-catalog-results">
                    @foreach (var hit in Hits)
                    {
                        <button type="button" class="rs-catalog-hit" @onclick="() => OnPreview.InvokeAsync(hit)" disabled="@Saving" @key="hit.ExternalId">
                            <span class="rs-row-art">
                                @if (!string.IsNullOrWhiteSpace(hit.ImageUrl))
                                {
                                    <img src="@hit.ImageUrl" alt="" />
                                }
                                else
                                {
                                    <Icon Name="@Kind.Icon()" />
                                }
                            </span>
                            <span class="rs-catalog-copy">
                                <strong>@hit.Title</strong>
                                <span class="rs-muted">
                                    @hit.Kind.Singular()
                                    · @(hit.ReleaseDate is DateOnly date ? ReleaseText.Long(date) : "No date yet")
                                </span>
                            </span>
                        </button>
                    }
                </div>
            }

            @if (!Manual)
            {
                <button type="button" class="rs-button" @onclick="OnShowManual">Add it yourself</button>
            }
        }

        @if (Preview is null && Editing && (!Creating || Manual))
        {
            <EditForm Model="Form" OnValidSubmit="OnSave">
                <DataAnnotationsValidator />

                @if (!string.IsNullOrWhiteSpace(Error))
                {
                    <p class="rs-validation" role="alert">@Error</p>
                }

                @if (CatalogLinked)
                {
                    <p class="rs-hint">The title, date, image, and description are refreshed from the catalog once a day. Notes stay yours.</p>
                }

                <div class="rs-field">
                    <label for="title">Title</label>
                    <InputText id="title" class="rs-input" @bind-Value="Form.Title" autofocus />
                    <ValidationMessage For="() => Form.Title" class="rs-validation" />
                </div>

                <div class="rs-field">
                    <label for="release">Release date</label>
                    <InputDate id="release" class="rs-input" @bind-Value="Form.ReleaseDate" />
                    <span class="rs-hint">Leave this empty if you don't know it yet. You'll be notified on this day.</span>
                </div>

                <div class="rs-field">
                    <label for="notes">Notes</label>
                    <InputTextArea id="notes" class="rs-textarea" @bind-Value="Form.Notes" />
                    <ValidationMessage For="() => Form.Notes" class="rs-validation" />
                </div>

                <div class="rs-field">
                    <label for="link">Link</label>
                    <InputText id="link" class="rs-input" @bind-Value="Form.LinkUrl" placeholder="https://" />
                    <ValidationMessage For="() => Form.LinkUrl" class="rs-validation" />
                </div>

                <div class="rs-field">
                    <label for="image">Image URL</label>
                    <InputText id="image" class="rs-input" @bind-Value="Form.ImageUrl" placeholder="https://" />
                    <ValidationMessage For="() => Form.ImageUrl" class="rs-validation" />
                </div>

                <div class="rs-form-actions">
                    <button type="button" class="rs-button" @onclick="OnCancelEdit" disabled="@Saving">Cancel</button>
                    <button type="submit" class="rs-button rs-button-primary" disabled="@Saving">
                        @(Creating ? "Add" : "Save")
                    </button>
                </div>
            </EditForm>
        }
        else if (Preview is null && Item is not null)
        {
            @if (!string.IsNullOrWhiteSpace(Item.ImageUrl))
            {
                <img class="rs-details-image" src="@Item.ImageUrl" alt="" />
            }

            <dl class="rs-facts">
                <dt>Release</dt>
                <dd>
                    @if (Item.ReleaseDate is DateOnly date)
                    {
                        <span>@ReleaseText.Long(date)</span>
                        <span class="rs-muted"> · @ReleaseText.Relative(date, Today)</span>
                    }
                    else
                    {
                        <span class="rs-muted">No date yet</span>
                    }
                </dd>
                @if (Item.CatalogSource is CatalogSource source)
                {
                    <dt>Source</dt>
                    <dd>@(source == CatalogSource.Igdb ? "IGDB" : "TMDB")</dd>
                }
            </dl>

            @if (!string.IsNullOrWhiteSpace(Item.Overview))
            {
                <section>
                    <h4>About</h4>
                    <p class="rs-notes">@Item.Overview</p>
                </section>
            }

            @if (!string.IsNullOrWhiteSpace(Item.Notes))
            {
                <section>
                    <h4>Notes</h4>
                    <p class="rs-notes">@Item.Notes</p>
                </section>
            }

            @if (!string.IsNullOrWhiteSpace(Item.LinkUrl))
            {
                <p>
                    <a class="rs-button" href="@Item.LinkUrl" target="_blank" rel="noopener noreferrer">
                        <Icon Name="link" /> Open link
                    </a>
                </p>
            }
        }
    </div>
</aside>
