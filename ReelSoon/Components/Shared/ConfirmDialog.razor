@if (visible)
{
    <div class="rs-modal-backdrop" @onclick="() => Close(false)">
        <div class="rs-modal" @onclick:stopPropagation="true">
            <h2>@title</h2>
            <p>@message</p>
            <div class="rs-modal-actions">
                <button type="button" class="rs-button" @onclick="() => Close(false)">Cancel</button>
                <button type="button" class="rs-button rs-button-danger" @onclick="() => Close(true)">Remove</button>
            </div>
        </div>
    </div>
}
