<aside class="nf-drawer" aria-label="Notifications">
    <header class="nf-drawer-head">
        <div class="nf-drawer-title">
            <Icon Name="bell" />
            <strong>Notifications</strong>
        </div>
        <div class="nf-drawer-actions">
            <button type="button" class="nf-icon-button" title="Close" @onclick="OnClose">
                <Icon Name="x" />
            </button>
        </div>
    </header>

    <div class="nf-drawer-body">
        @if (loading)
        {
            <p class="nf-muted">Loading.</p>
        }
        else if (loadError is not null)
        {
            <EmptyState Icon="alert" Title="Notifications could not be read" Description="@loadError" />
        }
        else if (items.Count == 0)
        {
            <EmptyState Icon="bell"
                        Title="You're up to date"
                        Description="When a movie, show or game on your list is released, it shows up here." />
        }
        else
        {
            <ul class="reel-notices">
                @foreach (var notice in items)
                {
                    <li class="reel-notice @(notice.IsUnread ? "is-unread" : null)" @key="notice.Id">
                        <div>
                            <strong>@notice.Title</strong>
                            <p>@notice.Message</p>
                            <span class="nf-muted nf-small">@When(notice.CreatedAt)</span>
                        </div>
                        <div class="reel-notice-actions">
                            <button type="button" class="nf-button" @onclick="() => ViewAsync(notice)">View</button>
                            <button type="button" class="nf-icon-button nf-danger-hover" title="Delete" @onclick="() => DeleteAsync(notice)">
                                <Icon Name="trash" />
                            </button>
                        </div>
                    </li>
                }
            </ul>
        }
    </div>
</aside>
